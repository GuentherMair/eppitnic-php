<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<epp xmlns="urn:ietf:params:xml:ns:epp-1.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="urn:ietf:params:xml:ns:epp-1.0 epp-1.0.xsd">
  <command>
    <update>
      <contact:update xmlns:contact="urn:ietf:params:xml:ns:contact-1.0"
                      xsi:schemaLocation="urn:ietf:params:xml:ns:contact-1.0 contact-1.0.xsd">
        <contact:id>{$id}</contact:id>
        {if count($postalinfo) gt 0 or count($addr) gt 0 or count($contact) gt 0 or $authinfo ne ""}
        <contact:chg>
        {if count($postalinfo) gt 0 or count($addr) gt 0}
          <contact:postalInfo type="loc">
          {foreach from=$postalinfo item=i}
            {if $i.value ne ""}<contact:{$i.name}>{$i.value}</contact:{$i.name}>{/if}
          {/foreach}
          {if count($addr)}
            <contact:addr>
            {foreach from=$addr item=i}
              {if $i.value ne ""}<contact:{$i.name}>{$i.value}</contact:{$i.name}>{/if}
            {/foreach}
            </contact:addr>
          {/if}
          </contact:postalInfo>
        {/if}
        {* $contact only ever contains fields the caller actually changed
           (Contact::update()), so an empty value here is a deliberate clear
           rather than "not mentioned". EPP expresses that as an empty element,
           which is only meaningful for the optional fields -- fax. *}
        {foreach from=$contact item=i}
          {if $i.value ne ""}<contact:{$i.name}>{$i.value}</contact:{$i.name}>{/if}
          {if $i.value eq "" && $i.name eq "fax"}<contact:{$i.name}/>{/if}
        {/foreach}
        {* authInfo belongs INSIDE <chg>, as the last element before <disclose>
           (contact-1.0.xsd "chgType": postalInfo, voice, fax, email, authInfo,
           disclose). It used to sit outside, as a sibling of <chg>, which the
           registry's own schema validation rejects with a 2001 "Command syntax
           error" -- so every contact update that rotated the auth code failed. *}
        {if $authinfo ne ""}
          <contact:authInfo>
            <contact:pw>{$authinfo|escape}</contact:pw>
          </contact:authInfo>
        {/if}
        </contact:chg>
        {/if}
      </contact:update>
    </update>
    {if $consentForPublishing === 0 or $consentForPublishing === 1 or $registrant}
    <extension>
      <extcon:update xmlns:extcon="http://www.nic.it/ITNIC-EPP/extcon-1.0"
                     xsi:schemaLocation="http://www.nic.it/ITNIC-EPP/extcon-1.0 extcon-1.0.xsd">
        {if $consentForPublishing === 0 or $consentForPublishing === 1}
        <extcon:consentForPublishing>{$consentForPublishing}</extcon:consentForPublishing>
        {/if}
        {if $registrant}
        <extcon:registrant>
          {if isset($registrant.nationalityCode)}<extcon:nationalityCode>{$registrant.nationalityCode}</extcon:nationalityCode>{/if}
          {if isset($registrant.entityType)}<extcon:entityType>{$registrant.entityType}</extcon:entityType>{/if}
          {if isset($registrant.regCode)}<extcon:regCode>{$registrant.regCode}</extcon:regCode>{/if}
          {if isset($registrant.schoolCode)}<extcon:schoolCode>{$registrant.schoolCode}</extcon:schoolCode>{/if}
        </extcon:registrant>
        {/if}
      </extcon:update>
    </extension>
    {/if}
    <clTRID>{$clTRID}</clTRID>
  </command>
</epp>
