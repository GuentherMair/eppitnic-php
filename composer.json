{
    "name": "inet-services/eppitnic",
    "description": "REST API and command line for registrars of the Italian domain registry (nic.it), over EPP",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "ext-dom": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-posix": "*",
        "ext-intl": "*",
        "algo26-matthias/idna-convert": "^3.1",
        "gabordemooij/redbean": "^5.7",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.8",
        "firebase/php-jwt": "^7.1",
        "spomky-labs/otphp": "^11.0",
        "phpmailer/phpmailer": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Eppitnic\\": "src/"
        },
        "files": [
            "config/constants.php"
        ]
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "phpunit/phpunit": "^11"
    },
    "autoload-dev": {
        "psr-4": {
            "Eppitnic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
