#!/usr/bin/env php
<?php

/**
 * eppitnic command line interface.
 *
 * All the work is in Eppitnic\Cli; this file is only the entry point, so that
 * dispatch and every subcommand stay testable without spawning a process.
 */

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "eppitnic must be run from the command line.\n");
    exit(1);
}

require_once dirname(__DIR__) . '/vendor/autoload.php';

use Eppitnic\Cli\Application;
use Eppitnic\Setup\ConfigMissing;

try {
    exit((new Application())->run($argv));
} catch (ConfigMissing $e) {
    // config/config.php doesn't exist yet -- point at the fix rather than
    // just the symptom. Caught ahead of the plain \RuntimeException below,
    // since ConfigMissing extends it and PHP matches catch blocks in order.
    fwrite(STDERR, "Error: " . $e->getMessage() . "\n");
    fwrite(STDERR, "Run 'eppitnic setup' to create it.\n");
    exit(CONFIG_ERROR);
} catch (\RuntimeException $e) {
    // Config throws these for an incomplete config/config.php or an
    // unreachable database -- a setup problem, and one worth stating plainly
    // rather than as a stack trace
    fwrite(STDERR, "Error: " . $e->getMessage() . "\n");
    exit(CONFIG_ERROR);
}
